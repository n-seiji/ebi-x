# Slack bot token (required).
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token for Socket Mode (required).
SLACK_APP_TOKEN=xapp-your-app-token

# Comma-separated Slack user IDs allowed to invoke ebi-x (required).
SLACK_ALLOWED_USER_IDS=U123,U456

# Comma-separated Slack channel IDs; leave empty to allow every channel.
SLACK_ALLOWED_CHANNEL_IDS=

# Allow app mentions sent by Slack workflows whose event workflow_id starts with Wf.
SLACK_ALLOW_WORKFLOWS=false

# Slack user ID mentioned when an unauthorized mention is rejected.
SLACK_ADMIN_USER_ID=U123

# Emoji reaction name that enables replies in an authorized mention's thread.
# Leave empty to disable thread subscriptions.
SLACK_THREAD_SUBSCRIPTION_REACTION=thread-subete

# Subscription duration. Must be positive when subscriptions are enabled.
SLACK_THREAD_SUBSCRIPTION_TTL=336h

# Codex executable path. Arguments are not supported.
CODEX_COMMAND=codex

# Optional Codex model name; leave empty to use the Codex default.
CODEX_MODEL=

# Maximum duration of one Codex turn.
CODEX_TIMEOUT=30m

# Root directory for workspace, memory, playbooks, and state.
EBIX_HOME=.

# Optional comma-separated extra writable directories. Paths overlapping
# EBIX_HOME/data/memory (including parents, children, and symlinks) are rejected.
EBIX_WRITABLE_ROOTS=
