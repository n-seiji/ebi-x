# Slack bot token (required).
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token for Socket Mode (required).
SLACK_APP_TOKEN=xapp-your-app-token

# Comma-separated Slack user IDs always allowed to invoke ebi-x (required
# unless SLACK_APPROVAL_CHANNEL_ID is set).
SLACK_ALLOWED_USER_IDS=U123,U456

# Comma-separated Slack channel IDs always allowed (required unless
# SLACK_APPROVAL_CHANNEL_ID is set).
SLACK_ALLOWED_CHANNEL_IDS=C123

# Channel where users, channels, and workflows outside the lists above are
# approved by mentioning the bot. Invite the bot to it.
SLACK_APPROVAL_CHANNEL_ID=

# Comma-separated Slack user IDs who may approve (required when
# SLACK_APPROVAL_CHANNEL_ID is set).
SLACK_APPROVER_USER_IDS=

# Allow app mentions sent by Slack workflows listed in
# SLACK_ALLOWED_WORKFLOW_IDS or approved in SLACK_APPROVAL_CHANNEL_ID (one of
# the two is required when this is true).
SLACK_ALLOW_WORKFLOWS=false
SLACK_ALLOWED_WORKFLOW_IDS=

# Slack user ID mentioned when an unauthorized mention is rejected.
SLACK_ADMIN_USER_ID=U123

# Emoji reaction name that enables replies in an authorized mention's thread.
# Leave empty to disable thread subscriptions.
SLACK_THREAD_SUBSCRIPTION_REACTION=thread-subete

# Subscription duration. Must be positive when subscriptions are enabled.
SLACK_THREAD_SUBSCRIPTION_TTL=336h

# Codex executable path. Arguments are not supported.
CODEX_COMMAND=codex

# Optional Codex model name; leave empty to use the Codex default.
CODEX_MODEL=

# Maximum duration of one Codex turn.
CODEX_TIMEOUT=30m

# Work turns for different Slack threads that may run at once (at least 1).
# Work turns within one thread always run one at a time.
CODEX_MAX_PARALLEL_WORK=3

# Root directory for workspace, memory, playbooks, and state.
EBIX_HOME=.

# Optional comma-separated extra writable directories. Paths overlapping
# protected paths (memory, state, .env, .codex, Codex credentials, and
# EBIX_DENIED_READ_PATHS; including parents, children, and symlinks) are rejected.
EBIX_WRITABLE_ROOTS=

# Optional comma-separated extra paths Codex commands may neither read nor
# write, such as ~/.aws. Do not list credentials work turns need, like the
# ones used for git push.
EBIX_DENIED_READ_PATHS=

# Comma-separated channel IDs whose work turns may write playbooks and global
# memory, which every channel reads. Empty means no channel may.
EBIX_SHARED_WRITE_CHANNEL_IDS=

# Git repositories among EBIX_WRITABLE_ROOTS are worked on through per-thread
# checkouts. Checkouts unused for this long are removed with their branches.
EBIX_CHECKOUT_IDLE_TTL=120h
